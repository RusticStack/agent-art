{
  "name": "@rusticstack/agent-art",
  "version": "1.0.1",
  "description": "Game art and audio for AI agents: MCP server + live web UI for pixel-art sprites, rigs and animations, tilesets, textures, low-poly 3D models (.glb), combat effects, planets, sound effects and music.",
  "type": "module",
  "bin": {
    "agent-art": "bin/agent-art.js"
  },
  "files": [
    "bin/",
    "src/",
    "!src/meshfixtures.js",
    "dist/ui/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/agent-art.js serve --open",
    "serve": "node bin/agent-art.js serve",
    "mcp": "node bin/agent-art.js mcp",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "check:ui": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test test/",
    "test:ui": "vitest run",
    "check:build": "node scripts/check-ui-build.js",
    "test:e2e": "npm run build:ui && node scripts/pw.mjs test",
    "test:e2e:install": "node scripts/pw.mjs install chromium",
    "docs:ui-shots": "npm run build:ui && node scripts/pw.mjs test --grep @shots",
    "check:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "prepack": "npm run build:ui",
    "docs:llms": "node scripts/build-llms.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agents",
    "claude",
    "pixel-art",
    "sprites",
    "spritesheet",
    "animation",
    "tileset",
    "gamedev",
    "game-assets",
    "gltf",
    "3d",
    "sound-effects",
    "procedural"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RusticStack/agent-art.git"
  },
  "homepage": "https://github.com/RusticStack/agent-art#readme",
  "bugs": "https://github.com/RusticStack/agent-art/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@dagrejs/dagre": "^3.1.3",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@types/three": "0.170.0",
    "@xyflow/svelte": "^1.7.1",
    "bits-ui": "^2.20.6",
    "fuzzysort": "^4.0.2",
    "jsdom": "^31.0.0",
    "lucide-static": "^1.70.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "three": "0.170.0",
    "typescript": "^6.0.0",
    "vanilla-colorful": "^0.7.2",
    "virtua": "^0.54.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
