{
  "name": "@rusticstack/agent-art",
  "version": "0.10.0",
  "description": "Game art and audio for AI agents: MCP server + live web UI for pixel-art sprites, rigs and animations, tilesets, textures, low-poly 3D models (.glb), combat effects, planets, sound effects and music.",
  "type": "module",
  "bin": {
    "agent-art": "bin/agent-art.js"
  },
  "files": [
    "bin/",
    "src/",
    "!src/meshfixtures.js",
    "dist/ui/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/agent-art.js serve --open",
    "serve": "node bin/agent-art.js serve",
    "mcp": "node bin/agent-art.js mcp",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "check:ui": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test test/",
    "test:ui": "vitest run",
    "prepack": "npm run build:ui",
    "docs:llms": "node scripts/build-llms.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agents",
    "claude",
    "pixel-art",
    "sprites",
    "spritesheet",
    "animation",
    "tileset",
    "gamedev",
    "game-assets",
    "gltf",
    "3d",
    "sound-effects",
    "procedural"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RusticStack/agent-art.git"
  },
  "homepage": "https://github.com/RusticStack/agent-art#readme",
  "bugs": "https://github.com/RusticStack/agent-art/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "three": "0.170.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
